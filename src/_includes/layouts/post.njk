---
layout: layouts/base.njk
---
<article class="post-shell">
  <header class="post-hero">
    {% if categories and categories.length %}
      <a class="eyebrow" href="{% if categories[0] == 'Travel Savings' %}/resources/{% else %}/category/{{ categories[0] | categorySlug }}/{% endif %}">{{ categories[0] }}</a>
    {% else %}
      <p class="eyebrow">{{ site.name }}</p>
    {% endif %}
    <h1>{{ title }}</h1>
  </header>

  {% if featuredImage %}
    <figure class="featured-image"><img src="{{ featuredImage }}" alt="{{ featuredImageAlt or title }}"></figure>
  {% endif %}

  <div class="content prose">
    {{ content | safe }}
  </div>

  <aside class="disclosure">
    <strong>Affiliate disclosure</strong>
    <p>Some links may be affiliate links, which means Wealth & Scrubs may earn a commission at no extra cost to you.</p>
  </aside>

  {% set related = collections.posts | relatedPosts(page) | limit(3) %}
  {% if related.length and not hideRelatedPosts %}
    <section class="related-posts" aria-labelledby="related-heading">
      <h2 id="related-heading">Keep Reading</h2>
      <div class="card-grid">
        {% for post in related %}
          {% include "partials/post-card.njk" %}
        {% endfor %}
      </div>
    </section>
  {% endif %}
</article>
