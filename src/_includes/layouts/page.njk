---
layout: layouts/base.njk
---
<article class="page-shell">
  {% if slug == "home" %}
    <header class="home-hero">
      <div>
        <p class="eyebrow">Smart Money. Healthcare Life. Everyday Ease.</p>
        <h1>Wealth &amp; Scrubs</h1>
        <p>Simple money tips, useful deals, side hustle ideas, and nurse-aware resources for busy women who want life to feel a little easier.</p>
        <div class="hero-actions">
          <a class="primary-button" href="#start-exploring">Start Exploring</a>
          <a class="text-button" href="#worth-checking-out">See What&rsquo;s New</a>
        </div>
      </div>
    </header>
  {% else %}
    <header class="page-hero">
      <p class="eyebrow">{{ eyebrow or site.name }}</p>
      <h1>{{ title }}</h1>
      {% if description %}<p>{{ description }}</p>{% endif %}
    </header>
  {% endif %}
  <div class="{% if slug == "home" %}home-content{% elif slug == "money-side-hustles" %}money-hub-content{% else %}content prose{% endif %}">
    {{ content | safe }}
  </div>
</article>
