---
layout: layouts/base.njk
---
<article class="page-shell">
  {% if slug == "home" %}
    <header class="home-hero" aria-labelledby="home-title">
      <div class="home-hero__copy">
        <p class="eyebrow">Luxury nurse energy. Real money moves.</p>
        <p class="home-hero__statement">Work in scrubs. Stack your money. Live beautifully.</p>
        <p class="home-hero__summary">A glamorous nurse-money hub for saving smarter, finding deals, building side income, and keeping a little sparkle in the life you are working so hard for.</p>
        <div class="hero-actions" aria-label="Homepage starting points">
          <a class="primary-button" href="#start-exploring">Explore Wealth &amp; Scrubs</a>
          <a class="text-button" href="/money-side-hustles/">Make &amp; Save Money</a>
        </div>
      </div>
      <div class="home-hero__visual" aria-label="Luxury Wealth and Scrubs crown stethoscope artwork">
        <span class="home-sparkle home-sparkle--one" aria-hidden="true">✦</span>
        <span class="home-sparkle home-sparkle--two" aria-hidden="true">◆</span>
        <span class="home-sparkle home-sparkle--three" aria-hidden="true">✧</span>
        <img src="/assets/uploads/wealth-scrubs-crown-stethoscope-hero.png" alt="Diamond crown with a pink rhinestone stethoscope on burgundy satin" loading="eager" fetchpriority="high" sizes="(max-width: 900px) calc(100vw - 52px), 548px">
        <h1 id="home-title" class="home-hero__photo-title">Wealth &amp; Scrubs</h1>
        <div class="home-hero__gloss" aria-hidden="true"></div>
        <p>Cashback to champagne energy.</p>
      </div>
    </header>
  {% elif slug != "nursing-life" %}
    <header class="page-hero">
      <p class="eyebrow">{{ eyebrow or site.name }}</p>
      <h1>{{ title }}</h1>
      {% if description %}<p>{{ description }}</p>{% endif %}
    </header>
  {% endif %}
  <div class="{% if slug == "home" %}home-content{% elif slug == "money-side-hustles" %}money-hub-content{% elif slug == "nursing-life" %}nursing-hub-content{% else %}content prose{% endif %}">
    {{ content | safe }}
  </div>
</article>
