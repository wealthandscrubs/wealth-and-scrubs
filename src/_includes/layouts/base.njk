<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title and title != site.name %}{{ title }} | {% elif category %}{{ category.name }} | {% endif %}{{ site.name }}</title>
    <meta name="description" content="{{ description or category.description or excerpt or site.description }}">
    <meta name="robots" content="index, follow">
    <meta name="googlebot" content="index, follow">
    <meta name="p:domain_verify" content="8e819bd01a460ef36da1bca227e4e1bd">
    <meta name="impact-site-verification" value="42be83db-b243-4a67-b6db-46e361c0a871">
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/uploads/wealth-and-scrubs-icon-192.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/assets/uploads/wealth-and-scrubs-icon-512.png">
    <link rel="apple-touch-icon" href="/assets/uploads/apple-touch-icon.png">
    <link rel="stylesheet" href="/assets/css/site.css?v=20260906-home-final">
    <link rel="alternate" type="application/atom+xml" title="{{ site.name }}" href="/feed.xml">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:title" content="{% if title and title != site.name %}{{ title }} | {{ site.name }}{% elif category %}{{ category.name }} | {{ site.name }}{% else %}{{ site.name }}{% endif %}">
    <meta property="og:description" content="{{ description or category.description or excerpt or site.description }}">
    <meta property="og:type" content="{% if tags and 'post' in tags %}article{% else %}website{% endif %}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    {% if featuredImage %}<meta property="og:image" content="{{ site.url }}{{ featuredImage }}">{% endif %}
    <meta name="twitter:card" content="{% if featuredImage %}summary_large_image{% else %}summary{% endif %}">
    <meta name="twitter:title" content="{% if title and title != site.name %}{{ title }} | {{ site.name }}{% elif category %}{{ category.name }} | {{ site.name }}{% else %}{{ site.name }}{% endif %}">
    <meta name="twitter:description" content="{{ description or category.description or excerpt or site.description }}">
    {% if featuredImage %}<meta name="twitter:image" content="{{ site.url }}{{ featuredImage }}">{% endif %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Organization",
            "@id": "{{ site.url }}/#organization",
            "name": "{{ site.name }}",
            "url": "{{ site.url }}/",
            "logo": "{{ site.url }}{{ site.logo }}",
            "sameAs": [
              {% for profile in site.sameAs %}"{{ profile }}"{% if not loop.last %},{% endif %}{% endfor %}
            ]
          },
          {
            "@type": "WebSite",
            "@id": "{{ site.url }}/#website",
            "name": "{{ site.name }}",
            "url": "{{ site.url }}/",
            "description": "{{ site.description }}",
            "publisher": { "@id": "{{ site.url }}/#organization" }
          }
          {% if tags and 'post' in tags %},
          {
            "@type": "BlogPosting",
            "@id": "{{ site.url }}{{ page.url }}#article",
            "headline": "{{ title }}",
            "description": "{{ description or excerpt or site.description }}",
            "datePublished": "{{ date | isoDate }}",
            "dateModified": "{{ page.date | isoDate }}",
            "author": {
              "@type": "Person",
              "name": "{{ author or site.author }}"
            },
            "publisher": { "@id": "{{ site.url }}/#organization" },
            "mainEntityOfPage": "{{ site.url }}{{ page.url }}"{% if featuredImage %},
            "image": "{{ site.url }}{{ featuredImage }}"{% endif %}
          }
          {% endif %}
        ]
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="{{ site.name }} home">
          <img class="brand-mark" src="/assets/uploads/wealth-and-scrubs-icon-192.png" alt="" width="48" height="48">
          <span class="brand-copy">
            <span>{{ site.name }}</span>
            <small>Nurses. Money. A brighter you.</small>
          </span>
        </a>
        <div class="header-menu">
          <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
            <span>Menu</span>
            <span class="nav-toggle__icon" aria-hidden="true"></span>
          </button>
          <nav id="site-nav" class="site-nav" aria-label="Main navigation">
            <p class="site-nav__label">Explore Wealth &amp; Scrubs</p>
            {% for item in navigation %}
              <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
            {% endfor %}
          </nav>
          <a class="header-search" href="/blog/" aria-label="Browse Wealth & Scrubs posts">
            <span aria-hidden="true">⌕</span>
          </a>
          <a class="header-cta" href="/#join-community">Let's Thrive <span aria-hidden="true">♡</span></a>
        </div>
      </div>
    </header>

    <main id="main-content">
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-community">
          <div>
            <p class="footer-script">Dream. Plan. Do. Repeat.</p>
            <p>Practical ideas, helpful resources, and a little sparkle for building more freedom on and off the clock.</p>
          </div>
          <figure>
            {% if page.url == "/" %}
              <img src="/assets/uploads/nursing-life-category-hero.png" alt="Rose-gold stethoscope and nursing essentials on a blush satin-toned surface" loading="eager" sizes="(max-width: 940px) calc(100vw - 36px), 620px">
            {% else %}
              <img src="/assets/uploads/wealth-scrubs-crown-stethoscope-hero.png" alt="Rose-gold stethoscope and jeweled crown on burgundy satin">
            {% endif %}
          </figure>
        </div>
        <div class="footer-grid">
          <nav aria-label="Quick links">
            <h2>Quick Links</h2>
            <a href="/">Home</a>
            <a href="/blog/">Blog</a>
            <a href="/money-side-hustles/">Money &amp; Side Hustles</a>
            <a href="/category/deals-discounts/">Deals &amp; Discounts</a>
            <a href="/nursing-life/">Nursing Life</a>
            <a href="/resources/">Travel Savings</a>
          </nav>
          <nav aria-label="Helpful information">
            <h2>Helpful Info</h2>
            <a href="/about/">About</a>
            <a href="/contact/">Contact</a>
            <a href="/privacy-policy/">Privacy Policy</a>
            <a href="/terms-and-conditions/">Terms &amp; Conditions</a>
            <a href="/affiliate-disclosure/">Affiliate Disclosure</a>
            <a href="/disclaimer/">Disclaimer</a>
          </nav>
          <nav aria-label="Social links">
            <h2>Connect</h2>
            <a href="https://t.me/WealthandScrubs" target="_blank" rel="noopener">Telegram</a>
            <a href="https://x.com/wealthandscrubs?s=11" target="_blank" rel="noopener">X</a>
            <a href="/contact/">Email</a>
          </nav>
        </div>
        <p class="site-footer__affiliate">As an Amazon Associate I earn from qualifying purchases. Some links may also be affiliate links, which means Wealth &amp; Scrubs may earn a commission at no extra cost to you.</p>
        <p class="copyright">&copy; {% year %} {{ site.name }}. All rights reserved. Because you do so much, you deserve more.</p>
      </div>
    </footer>
    <script src="/assets/js/site.js" defer></script>
  </body>
</html>
