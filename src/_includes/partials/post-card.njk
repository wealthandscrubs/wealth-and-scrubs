<article class="post-card{% if compactCard %} post-card--compact{% endif %}"{% if usePostAnchors %} id="{{ post.data.slug or post.fileSlug }}"{% endif %}>
  {% if post.data.featuredImage and not compactCard %}
    <a class="card-image" href="{{ post.url }}" tabindex="-1" aria-hidden="true">
      <img src="{{ post.data.featuredImage }}" alt="{{ post.data.title }}" loading="lazy">
    </a>
  {% endif %}
  <div class="card-body">
    {% if post.data.categories and post.data.categories.length %}
      <span class="card-category">{{ post.data.categories[0] }}</span>
    {% endif %}
    <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
    {% if not compactCard %}
      <p>{{ post.data.excerpt or "Practical ideas from Wealth & Scrubs." }}</p>
    {% endif %}
    <span class="card-date">{{ post.date | readableDate }}</span>
  </div>
</article>
